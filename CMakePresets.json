{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "posix-debug",
      "displayName": "Debug (Posix, EdgeML)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/posix-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BOOTCTRL_ENABLE_EDGEML": "ON",
        "FORTE_TESTS": "ON"
      }
    },
    {
      "name": "posix-release",
      "displayName": "Release (Posix, EdgeML)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/posix-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BOOTCTRL_ENABLE_EDGEML": "ON",
        "FORTE_TESTS": "OFF"
      }
    }
  ]
}
